{
    "name": "glade-workspace",
    "displayName": "Glade Workspace",
    "description": "Workspace directory views.",
    "icon": "images/glade.png",
    "version": "0.0.4",
    "engines": {
        "vscode": "^1.125.0"
    },
    "publisher": "edobrowo",
    "repository": {
        "type": "git",
        "url": "https://github.com/edobrowo/glade"
    },
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.topLevelTrackFile",
                "title": "Track File In Top Level",
                "icon": "$(new-file)"
            },
            {
                "command": "extension.topLevelCreateFolder",
                "title": "Create Folder",
                "icon": "$(new-folder)"
            },
            {
                "command": "extension.topLevelCollapseAll",
                "title": "Collapse All",
                "icon": "$(collapse-all)"
            },
            {
                "command": "extension.createFolder",
                "title": "Create Folder",
                "icon": "$(new-folder)"
            },
            {
                "command": "extension.editFolderName",
                "title": "Edit Folder Name",
                "icon": "$(rename)"
            },
            {
                "command": "extension.pickFolderColor",
                "title": "Pick Folder Color",
                "icon": "$(symbol-color)"
            },
            {
                "command": "extension.removeFolder",
                "title": "Remove Folder",
                "icon": "$(trash)"
            },
            {
                "command": "extension.trackFile",
                "title": "Track File",
                "icon": "$(new-file)"
            },
            {
                "command": "extension.untrackFile",
                "title": "Untrack File",
                "icon": "$(remove)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "extension.topLevelTrackFile",
                    "when": "view == gladeTrees",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.topLevelCreateFolder",
                    "when": "view == gladeTrees",
                    "group": "navigation@2"
                },
                {
                    "command": "extension.topLevelCollapseAll",
                    "when": "view == gladeTrees",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.untrackFile",
                    "when": "view == gladeTrees && viewItem == gladeFile",
                    "group": "inline"
                },
                {
                    "command": "extension.untrackFile",
                    "when": "view == gladeTrees && viewItem == gladeFile",
                    "group": "1_manage"
                },
                {
                    "command": "extension.trackFile",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "inline@1"
                },
                {
                    "command": "extension.createFolder",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "inline@2"
                },
                {
                    "command": "extension.editFolderName",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "inline@3"
                },
                {
                    "command": "extension.pickFolderColor",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "inline@4"
                },
                {
                    "command": "extension.editFolderName",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "0_edit@1"
                },
                {
                    "command": "extension.pickFolderColor",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "0_edit@2"
                },
                {
                    "command": "extension.trackFile",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "1_manage@1"
                },
                {
                    "command": "extension.createFolder",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "1_manage@2"
                },
                {
                    "command": "extension.removeFolder",
                    "when": "view == gladeTrees && viewItem == gladeFolder",
                    "group": "1_manage@3"
                }
            ],
            "commandPalette": [
                {
                    "command": "extension.createFolder",
                    "when": "false"
                },
                {
                    "command": "extension.editFolderName",
                    "when": "false"
                },
                {
                    "command": "extension.pickFolderColor",
                    "when": "false"
                },
                {
                    "command": "extension.removeFolder",
                    "when": "false"
                },
                {
                    "command": "extension.topLevelTrackFile",
                    "when": "true"
                },
                {
                    "command": "extension.trackFile",
                    "when": "false"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "glade",
                    "title": "glade",
                    "icon": "images/glade.png"
                }
            ]
        },
        "views": {
            "glade": [
                {
                    "id": "gladeTrees",
                    "name": "Workspace",
                    "icon": "images/glade.png"
                }
            ]
        }
    },
    "author": "edobrowo",
    "license": "MIT",
    "type": "commonjs",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.125.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "typescript-eslint": "^8.61.1",
        "eslint": "^10.5.0",
        "typescript": "^6.0.3",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
