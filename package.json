{
    "name": "glade",
    "displayName": "glade",
    "description": "Codebase notes.",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.105.0"
    },
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.createTextItem",
                "title": "Create Text Item",
                "icon": "$(add)"
            },
            {
                "command": "extension.removeTextItem",
                "title": "Remove Text Item",
                "icon": "$(remove)"
            },
            {
                "command": "extension.editTextItem",
                "title": "Edit Text Item",
                "icon": "$(edit)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "extension.createTextItem",
                    "when": "view == gladeView",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.editTextItem",
                    "when": "view == gladeView && viewItem == gladeTextItem",
                    "group": "inline"
                },
                {
                    "command": "extension.removeTextItem",
                    "when": "view == gladeView && viewItem == gladeTextItem",
                    "group": "inline"
                }
            ],
            "commandPalette": [
                {
                    "command": "extension.editTextItem",
                    "when": "false"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "glade",
                    "title": "glade",
                    "icon": "resources/glade.svg"
                }
            ]
        },
        "views": {
            "glade": [
                {
                    "id": "gladeView",
                    "name": "My Trees",
                    "icon": "resources/glade.svg"
                }
            ]
        }
    },
    "author": "edobrowo",
    "license": "ISC",
    "type": "commonjs",
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.5.0",
        "@types/vscode": "^1.110.0",
        "eslint": "^10.1.0",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.0"
    }
}
